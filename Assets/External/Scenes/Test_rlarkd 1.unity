  - coachText: "\uC774\uBC88\uC5D4 <color=#FF7300>\uC815\uBA74\uCDA9\uB3CC</color>\uC774\uB2E4.\n\uB124\uAC00
      \uACF5\uACA9\uC744 \uC2DC\uC791\uD558\uBA74 \uC801\uB3C4 <color=#FF7300>\uBE44\uC2B7\uD55C
      \uD0C0\uC774\uBC0D</color>\uC5D0 \uACF5\uACA9\uD55C\uB2E4.\n\uACF5\uACA9\uC774
