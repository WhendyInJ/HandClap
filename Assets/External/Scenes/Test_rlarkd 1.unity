      m_PersistentCalls:
        m_Calls: []
    onStepFinished:
      m_PersistentCalls:
        m_Calls: []
  - coachText: "\uC774\uBC88\uC5D4 <color=#FF7300>\uC801</color>\uB3C4 \uBC18\uC751\uD55C\uB2E4.\n\uC801
      <color=#FF7300>\uAE00\uB7EC\uBE0C</color>\uB97C \uC798 \uBC14\uB77C\uBCF4\uACE0
      <color=#FF7300>\uACF5\uACA9 \uD0C0\uC774\uBC0D</color>\uC744 \uC798 \uC9C0\uCF1C\uBD10\n\uC801\uC5D0\uAC8C
      \uB9DE\uC544\uBCF4\uBA74\uC11C <color=#FF7300>5\uBC88</color> \uB54C\uB824\uBD10"
    displaySeconds: 0
    requiredPlayerBasicAttacks: 5
    requiredPlayerDodgeSuccesses: 0
    requiredIgnoredEnemyFeints: 0
    requiredForcedClashes: 0
    pauseEnemyAi: 1
    enemyReactsToPlayerBasicAttack: 1
    enemyAutoAttackInterval: 2
    enemyAutoAttackStartsImmediately: 0
    enemyAutoMixAttackAndFeint: 0
    enemyAutoFeintChance: 0.5
    forceSimultaneousAttackClash: 0
    waitUntilRequirementsCompleted: 1
    onStepStarted:
      m_PersistentCalls:
        m_Calls: []
    onStepFinished:
      m_PersistentCalls:
        m_Calls: []
  - coachText: "\uC774\uBC88\uC5D4 <color=#FF7300>\uD53C\uD558\uAE30</color>\uB2E4.\n<color=#FF7300>[Shift]</color>\uB97C
      \uB20C\uB7EC \uC801\uC758 \uACF5\uACA9\uC744 <color=#FF7300>5\uBC88</color>
      \uD68C\uD53C\uD574 \uBD10.\n\uD68C\uD53C\uC5D0 \uC131\uACF5\uD558\uBA74 \uC801\uC774
      \uC7A0\uC2DC <color=#FF7300>\uCDE8\uC57D</color>\uD574\uC9C4\uB2E4.\n\uADF8\uB54C
      \uACF5\uACA9\uD558\uBA74 <color=#FF7300>\uB354 \uD070 \uB370\uBBF8\uC9C0</color>\uB97C
      \uC904 \uC218 \uC788\uB2E4.\n\uC790\uC2E0\uB3C4 \uB118\uC5B4\uC9C8 \uC218 \uC788\uC73C\uB2C8
      <color=#FF7300>[Space]</color>\uB85C \uC798 \uBC84\uD2F0\uB3C4\uB85D "
    displaySeconds: 0
    requiredPlayerBasicAttacks: 0
    requiredPlayerDodgeSuccesses: 5
    requiredIgnoredEnemyFeints: 0
    requiredForcedClashes: 0
    pauseEnemyAi: 1
    enemyReactsToPlayerBasicAttack: 0
    enemyAutoAttackInterval: 4
