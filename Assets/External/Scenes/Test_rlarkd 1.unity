  - coachText: "\uC774\uBC88\uC5D4 <color=#FF7300>\uD398\uC774\uD06C</color>\uB97C
      \uC77D\uB294 \uC5F0\uC2B5\uC774\uB2E4.\n\uC801\uC740 <color=#FF7300>\uACF5\uACA9</color>\uACFC
      <color=#FF7300>\uD398\uC774\uD06C</color>\uB97C \uC11E\uC5B4\uC11C \uC0AC\uC6A9\uD55C\uB2E4.
      \n\uC801 \uACF5\uACA9\uC2DC \uD53C\uD558\uACE0 \uD398\uC774\uD06C\uC2DC <color=#FF7300>\uC544\uBB34\uAC83\uB3C4
      \uB204\uB974\uC9C0\uB9C8</color>.\n\uC801\uC758 \uD398\uC774\uD06C\uB97C <color=#FF7300>5\uBC88</color>
      \uD758\uB824\uBCF4\uB0B4\uBA74 \uC131\uACF5\uC774\uB2E4."
    displaySeconds: 0
    requiredPlayerBasicAttacks: 0
    requiredPlayerDodgeSuccesses: 0
    requiredIgnoredEnemyFeints: 5
    requiredForcedClashes: 0
